# ── HubSpot portals ─────────────────────────────────────────────
# One private-app / static access token per portal. Set these in Vercel
# (Project → Settings → Environment Variables, Production), never in git.
HS_TOKEN_NEWDAWN=
HS_TOKEN_CLAY=
HS_TOKEN_SQG=

# Expected Hub ID per portal. A token that belongs to a different Hub ID
# disables that portal. New Dawn's is hard-coded (246454273); set the others.
# If unset, list_portals tells you the ID the token actually belongs to.
HS_PORTAL_ID_CLAY=
HS_PORTAL_ID_SQG=

# Optional extra blocked domains per portal (comma-separated).
# hologic.com is already blocked for newdawn and clay in lib/portals.ts.
# BLOCKED_DOMAINS_NEWDAWN=
# BLOCKED_DOMAINS_CLAY=
# BLOCKED_DOMAINS_SQG=

# ── Sign-in (OAuth) ─────────────────────────────────────────────
# Issuer URL of your OAuth provider (WorkOS AuthKit, Clerk, ...).
AUTH_ISSUER=
# Optional: JWKS URL (discovered from the issuer if blank) and expected audience.
# AUTH_JWKS_URL=
# AUTH_AUDIENCE=

# Who may use the connector. Fail-closed: if both are empty nobody gets in.
# On first connect, a denied sign-in logs your `sub` in Vercel logs; copy it here.
ALLOWED_SUBJECTS=
ALLOWED_EMAILS=

# Local development only (ignored on Vercel): skip sign-in.
# MCP_DEV_NO_AUTH=1
